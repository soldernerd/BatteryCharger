<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BatteryCharger.App</RootNamespace>
    <AssemblyName>BatteryCharger</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\BatteryCharger.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkSelfContained>true</WindowsAppSdkSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultLanguage>en-US</DefaultLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Custom entry point (Program.cs): lets the same exe act as the out-of-process VISA probe. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window / taskbar icon, loaded at runtime by MainWindow. -->
    <Content Include="Assets\BatteryCharger.ico" CopyToOutputDirectory="PreserveNewest" Link="Assets\BatteryCharger.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BatteryCharger.Core\BatteryCharger.Core.csproj" />
    <ProjectReference Include="..\BatteryCharger.Instruments\BatteryCharger.Instruments.csproj" />
  </ItemGroup>

  <!--
    dotnet publish does not copy XBF (compiled XAML) or the app PRI file for
    WinUI 3 unpackaged apps. This target copies them from the build output after
    publish so the app can load its UI when run from the publish folder.
  -->
  <Target Name="CopyWinUIAssetsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_AppXbfFiles Include="$(OutDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_AppXbfFiles)"
          DestinationFiles="@(_AppXbfFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri"
          DestinationFolder="$(PublishDir)"
          Condition="Exists('$(OutDir)$(AssemblyName).pri')" />
  </Target>

</Project>
