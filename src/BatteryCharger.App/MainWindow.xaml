<Window
    x:Class="BatteryCharger.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <NavigationView x:Name="Nav"
                    PaneDisplayMode="Left"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="True"
                    OpenPaneLength="200"
                    SelectionChanged="OnSelectionChanged"
                    AutomationProperties.Name="Main navigation">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="ChargerItem" Content="Charger" Tag="charger" AutomationProperties.Name="Charger">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE83E;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="ConsoleItem" Content="SCPI console" Tag="console" Visibility="Collapsed" AutomationProperties.Name="SCPI console">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE756;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <Grid>
            <Frame x:Name="ContentFrame"/>
            <StackPanel x:Name="BusyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing x:Name="Busy" IsActive="True" Width="40" Height="40"/>
                <TextBlock Text="Checking for VISA..." HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </NavigationView>
</Window>
