<Page
    x:Class="BatteryCharger.App.Views.ScpiConsolePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32,24,32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="SCPI console" Style="{StaticResource TitleTextBlockStyle}"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Developer tool for hardware bring-up. Commands go straight to the connected supply: do not use it while a charge is running. Anything containing a question mark is sent as a query."/>
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{x:Bind ViewModel.Command, Mode=TwoWay}" PlaceholderText="SCPI command, e.g. *IDN?"
                     KeyDown="OnCommandKeyDown" AutomationProperties.Name="SCPI command" FontFamily="Consolas"/>
            <Button Grid.Column="1" Content="Send" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SendCommand}"/>
            <Button Grid.Column="2" Content="Read errors" Command="{x:Bind ViewModel.ReadErrorsCommand}"/>
            <Button Grid.Column="3" Content="Clear" Command="{x:Bind ViewModel.ClearCommand}"/>
        </Grid>
        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Foreground="#C42B1C" TextWrapping="Wrap"/>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Lines}" SelectionMode="None" AutomationProperties.Name="SCPI traffic">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
